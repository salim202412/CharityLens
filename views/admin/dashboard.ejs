<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Admin Dashboard</title>

    <!-- Font Awesome -->
<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
   <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">


</head>

<body>
    <%- include('../partials/navbar', {
        currentPage: 'admin-dashboard',
        user: user
    }) %>
    <%- include('../partials/page-navigation') %>
    <div class="admin-container">
    

    <!-- TITLE -->

    <h1 class="page-title">

        Admin Dashboard

    </h1>

    <p class="subtitle">

        Monitor platform performance, manage donations,
        track fundraising activity, and verify cases.

    </p>

    <!-- DASHBOARD GRID -->

    <div class="dashboard-grid">

        <!-- TOTAL RAISED -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-indian-rupee-sign"></i>

            </div>

            <h2>

                ₹<%= totalRaised %>

            </h2>

            <p>

                Total Raised

            </p>

        </div>

        <!-- OPEN CASES -->

<a href="/admin/cases"
class="dashboard-card-link">

    <div class="card">

        <div class="card-icon">

            <i class="fa-solid fa-folder-open"></i>

        </div>

        <h2>

            <%= openCases %>

        </h2>

        <p>

            Open Cases

        </p>

    </div>

</a>

        <!-- CLOSED CASES -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-circle-check"></i>

            </div>

            <h2>

                <%= closedCases %>

            </h2>

            <p>

                Closed Cases

            </p>

        </div>

        <!-- DONORS -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-users"></i>

            </div>

            <h2>

                <%= totalDonors %>

            </h2>

            <p>

                Total Donors

            </p>

        </div>

        <!-- PENDING -->

<a href="/admin/cases"
class="dashboard-card-link">

    <div class="card">

        <div class="card-icon">

            <i class="fa-solid fa-clock"></i>

        </div>

        <h2>

            <%= pendingVerifications %>

        </h2>

        <p>

            Pending Verifications

        </p>

    </div>

</a>
</div>
    <!-- TABLE -->

    <div class="table-wrapper">

        <h2 class="table-heading">

            Recent Donations

        </h2>

        <table>

            <thead>

                <tr>

                    <th>Donor</th>

                    <th>Case</th>

                    <th>Amount</th>

                    <th>Date</th>

                    <th>Status</th>

                </tr>

            </thead>

            <tbody>

                <% recentDonations.forEach(donation => { %>

                    <tr>

                        <td>

                            <%= donation.donorId?.name || 'Unknown' %>

                        </td>

                        <td>

                            <%= donation.caseId?.title || 'Deleted Case' %>

                        </td>

                        <td>

                            ₹<%= donation.amount %>

                        </td>

                        <td>

                            <%= new Date(donation.createdAt)
                                .toLocaleDateString() %>

                        </td>

                        <td>

                            <span class="<%= donation.status %>">

                                <%= donation.status %>

                            </span>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>


</div>
</body>

</html>