<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Admin Dashboard</title>

    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, sans-serif;
        }

        body{

            min-height:100vh;

            background: linear-gradient(
                180deg,
                #5a5df0 0%,
                #8f2fff 55%,
                #ff3ba7 100%
            );

            padding-bottom:40px;
        }

        /* NAVBAR */

        .navbar{

            width:100%;

            padding:20px 8%;

            display:flex;

            justify-content:space-between;

            align-items:center;

            background:rgba(255,255,255,0.08);

            backdrop-filter: blur(10px);

            margin-bottom:50px;
        }

        .logo{

            display:flex;
            align-items:center;
            gap:10px;
        }

        .logo-icon{

            width:45px;
            height:45px;

            border-radius:50%;

            background:rgba(255,255,255,0.15);

            display:flex;
            justify-content:center;
            align-items:center;

            color:white;
            font-size:18px;
        }

        .logo h2{

            color:white;
            font-size:28px;
        }

        .nav-links{

            display:flex;
            align-items:center;
            gap:25px;
        }

        .nav-links a{

            color:white;

            text-decoration:none;

            font-weight:600;

            transition:0.3s;
        }

        .nav-links a:hover{

            opacity:0.8;
        }

        /* PAGE TITLE */

        .page-title{

            text-align:center;

            color:white;

            font-size:50px;

            margin-bottom:15px;
        }

        .subtitle{

            text-align:center;

            color:#f3f4f6;

            font-size:18px;

            margin-bottom:50px;
        }

        /* DASHBOARD GRID */

        .dashboard-grid{

            width:90%;

            max-width:1400px;

            margin:auto auto 50px;

            display:grid;

            grid-template-columns:
                repeat(auto-fit, minmax(240px, 1fr));

            gap:25px;
        }

        /* CARD */

        .card{

            background:rgba(255,255,255,0.12);

            backdrop-filter: blur(14px);

            border-radius:24px;

            padding:35px 25px;

            text-align:center;

            color:white;

            box-shadow:0 10px 35px rgba(0,0,0,0.2);

            transition:0.3s;
        }

        .card:hover{

            transform:translateY(-5px);
        }

        .card-icon{

            width:75px;
            height:75px;

            margin:0 auto 20px;

            border-radius:50%;

            display:flex;
            justify-content:center;
            align-items:center;

            font-size:28px;

            background:linear-gradient(
                135deg,
                #4f46e5,
                #a200ff
            );

            box-shadow:0 10px 25px rgba(0,0,0,0.25);
        }

        .card h2{

            font-size:42px;

            margin-bottom:12px;
        }

        .card p{

            color:#f3f4f6;

            font-size:17px;
        }

        /* TABLE SECTION */

        .table-wrapper{

            width:90%;

            max-width:1400px;

            margin:auto;

            background:rgba(255,255,255,0.12);

            backdrop-filter: blur(14px);

            border-radius:24px;

            padding:30px;

            box-shadow:0 10px 35px rgba(0,0,0,0.2);

            overflow-x:auto;
        }

        .table-heading{

            color:white;

            font-size:32px;

            margin-bottom:25px;

            text-align:center;
        }

        /* TABLE */

        table{

            width:100%;

            border-collapse:collapse;

            color:white;

            min-width:750px;
        }

        th{

            background:rgba(255,255,255,0.18);

            padding:18px;

            font-size:15px;

            text-transform:uppercase;

            letter-spacing:0.5px;
        }

        td{

            padding:18px;

            text-align:center;

            border-bottom:1px solid rgba(255,255,255,0.12);

            color:#f3f4f6;
        }

        tr:hover{

            background:rgba(255,255,255,0.06);
        }

        /* STATUS */

        .success,
        .pending,
        .failed{

            padding:8px 16px;

            border-radius:30px;

            font-size:13px;

            font-weight:bold;

            text-transform:uppercase;

            display:inline-block;
        }

        .success{

            background:#22c55e;

            color:white;
        }

        .pending{

            background:#f59e0b;

            color:white;
        }

        .failed{

            background:crimson;

            color:white;
        }

        /* FOOTER */

        .footer-text{

            text-align:center;

            margin-top:45px;

            color:white;

            font-size:14px;
        }

        /* RESPONSIVE */

        @media(max-width:768px){

            .navbar{

                flex-direction:column;

                gap:20px;
            }

            .nav-links{

                flex-wrap:wrap;

                justify-content:center;
            }

            .page-title{

                font-size:38px;
            }

            .subtitle{

                font-size:16px;

                padding:0 15px;
            }

            .table-wrapper{

                padding:20px;
            }

        }

    </style>

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">

            <div class="logo-icon">

                <i class="fa-solid fa-shield-heart"></i>

            </div>

            <h2>CharityLens Admin</h2>

        </div>

        <div class="nav-links">

            <a href="/admin/dashboard">
                Dashboard
            </a>

            <a href="/admin/cases">
                Manage Cases
            </a>

            <a href="/auth/logout">
                Logout
            </a>

        </div>

    </nav>

    <!-- TITLE -->

    <h1 class="page-title">

        Admin Dashboard

    </h1>

    <p class="subtitle">

        Monitor platform performance, manage donations,
        track fundraising activity, and verify cases.

    </p>

    <!-- DASHBOARD GRID -->

    <div class="dashboard-grid">

        <!-- TOTAL RAISED -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-indian-rupee-sign"></i>

            </div>

            <h2>

                ₹<%= totalRaised %>

            </h2>

            <p>

                Total Raised

            </p>

        </div>

        <!-- OPEN CASES -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-folder-open"></i>

            </div>

            <h2>

                <%= openCases %>

            </h2>

            <p>

                Open Cases

            </p>

        </div>

        <!-- CLOSED CASES -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-circle-check"></i>

            </div>

            <h2>

                <%= closedCases %>

            </h2>

            <p>

                Closed Cases

            </p>

        </div>

        <!-- DONORS -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-users"></i>

            </div>

            <h2>

                <%= totalDonors %>

            </h2>

            <p>

                Total Donors

            </p>

        </div>

        <!-- PENDING -->

        <div class="card">

            <div class="card-icon">

                <i class="fa-solid fa-clock"></i>

            </div>

            <h2>

                <%= pendingVerifications %>

            </h2>

            <p>

                Pending Verifications

            </p>

        </div>

    </div>

    <!-- TABLE -->

    <div class="table-wrapper">

        <h2 class="table-heading">

            Recent Donations

        </h2>

        <table>

            <thead>

                <tr>

                    <th>Donor</th>

                    <th>Case</th>

                    <th>Amount</th>

                    <th>Date</th>

                    <th>Status</th>

                </tr>

            </thead>

            <tbody>

                <% recentDonations.forEach(donation => { %>

                    <tr>

                        <td>

                            <%= donation.donorId?.name || 'Unknown' %>

                        </td>

                        <td>

                            <%= donation.caseId?.title || 'Deleted Case' %>

                        </td>

                        <td>

                            ₹<%= donation.amount %>

                        </td>

                        <td>

                            <%= new Date(donation.createdAt)
                                .toLocaleDateString() %>

                        </td>

                        <td>

                            <span class="<%= donation.status %>">

                                <%= donation.status %>

                            </span>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

    <!-- FOOTER -->

    <div class="footer-text">

        Protected by end-to-end encryption

    </div>

</body>

</html>