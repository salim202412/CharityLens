<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Admin Cases</title>

    
    <!-- Font Awesome -->
    <link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    
</head>

<body>

    <!-- NAVBAR -->

    <%- include('../partials/navbar', {
    currentPage: 'admin-cases',
    user: user
}) %>
<%- include('../partials/page-navigation') %>
    <!-- TITLE -->

    <h1 class="page-title">

        Admin Case Management

    </h1>

    <p class="subtitle">

        Verify submitted fundraising cases, review beneficiary
        requests, and manage platform transparency.

    </p>

    <!-- TABLE -->

    <div class="table-wrapper">

        <table>

            <thead>

                <tr>

                    <th>Title</th>

                    <th>Category</th>

                    <th>Beneficiary</th>

                    <th>Required</th>

                    <th>Collected</th>

                    <th>Status</th>

                    <th>Priority</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                <% cases.forEach(singleCase => { %>

                    <tr>

                        <!-- TITLE -->

                        <td>

                            <%= singleCase.title %>

                        </td>

                        <!-- CATEGORY -->

                        <td>

                            <%= singleCase.category %>

                        </td>

                        <!-- BENEFICIARY -->

                        <td>

                            <%= singleCase.beneficiaryId?.name || 'N/A' %>

                        </td>

                        <!-- REQUIRED -->

                        <td>

                            ₹<%= Number(singleCase.requiredAmount).toLocaleString() %>
                        </td>

                        <!-- COLLECTED -->

                        <td>

                            ₹<%= Number(singleCase.collectedAmount).toLocaleString() %>

                        </td>

                        <!-- STATUS -->

                        <td>

                            <% if(singleCase.isClosed) { %>

                                <span class="closed-badge">

                                    Closed

                                </span>

                            <% } else if(singleCase.isVerified) { %>

                                <span class="verified-badge">

                                    Verified

                                </span>

                            <% } else { %>

                                <span class="pending-badge">

                                    Pending

                                </span>

                            <% } %>

                        </td>

                        <!-- PRIORITY -->

                        <td>

    <select class="priority-select">

        <option
            <%= singleCase.priority === 'Low' ? 'selected' : '' %>>
            Low
        </option>

        <option
            <%= singleCase.priority === 'Medium' ? 'selected' : '' %>>
            Medium
        </option>

        <option
            <%= singleCase.priority === 'High' ? 'selected' : '' %>>
            High
        </option>

        <option
            <%= singleCase.priority === 'Critical' ? 'selected' : '' %>>
            Critical
        </option>

    </select>

</td>

                        <!-- ACTIONS -->

                        <td>

    <div class="action-buttons">

        <a
            href="/admin/cases/<%= singleCase._id %>"
            class="view-btn"
        >

            <i class="fa-solid fa-eye"></i>

            View

        </a>

        <% if(!singleCase.isVerified) { %>

            <form
                action="/admin/cases/<%= singleCase._id %>/verify"
                method="POST"
            >

                <button class="verify-btn">

                    <i class="fa-solid fa-check"></i>

                    Verify

                </button>

            </form>

        <% } %>

        <% if(!singleCase.isRejected) { %>

            <form
                action="/admin/cases/<%= singleCase._id %>/reject"
                method="POST"
            >

                <button class="reject-btn">

                    <i class="fa-solid fa-xmark"></i>

                    Reject

                </button>

            </form>

        <% } %>

    </div>

</td>
                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

   
</body>

</html>