<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Admin Cases</title>

    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, sans-serif;
        }

        body{

            min-height:100vh;

            background: linear-gradient(
                180deg,
                #5a5df0 0%,
                #8f2fff 55%,
                #ff3ba7 100%
            );

            padding-bottom:40px;
        }

        /* NAVBAR */

        .navbar{

            width:100%;

            padding:20px 8%;

            display:flex;

            justify-content:space-between;

            align-items:center;

            background:rgba(255,255,255,0.08);

            backdrop-filter: blur(10px);

            margin-bottom:50px;
        }

        .logo{

            display:flex;
            align-items:center;
            gap:10px;
        }

        .logo-icon{

            width:45px;
            height:45px;

            border-radius:50%;

            background:rgba(255,255,255,0.15);

            display:flex;
            justify-content:center;
            align-items:center;

            color:white;
            font-size:18px;
        }

        .logo h2{

            color:white;
            font-size:28px;
        }

        .nav-links{

            display:flex;
            align-items:center;
            gap:25px;
        }

        .nav-links a{

            color:white;

            text-decoration:none;

            font-weight:600;

            transition:0.3s;
        }

        .nav-links a:hover{

            opacity:0.8;
        }

        /* PAGE TITLE */

        .page-title{

            text-align:center;

            color:white;

            font-size:48px;

            margin-bottom:15px;
        }

        .subtitle{

            text-align:center;

            color:#f3f4f6;

            font-size:18px;

            margin-bottom:45px;
        }

        /* TABLE SECTION */

        .table-wrapper{

            width:95%;

            max-width:1500px;

            margin:auto;

            background:rgba(255,255,255,0.12);

            backdrop-filter: blur(14px);

            border-radius:24px;

            padding:30px;

            box-shadow:0 10px 35px rgba(0,0,0,0.2);

            overflow-x:auto;
        }

        /* TABLE */

        table{

            width:100%;

            border-collapse:collapse;

            color:white;

            min-width:1100px;
        }

        th{

            background:rgba(255,255,255,0.18);

            padding:18px;

            font-size:14px;

            text-transform:uppercase;

            letter-spacing:0.5px;
        }

        td{

            padding:18px;

            text-align:center;

            border-bottom:1px solid rgba(255,255,255,0.12);

            color:#f3f4f6;
        }

        tr:hover{

            background:rgba(255,255,255,0.06);
        }

        /* STATUS BADGES */

        .closed-badge,
        .verified-badge,
        .pending-badge{

            display:inline-block;

            padding:8px 16px;

            border-radius:30px;

            font-size:12px;

            font-weight:bold;

            text-transform:uppercase;
        }

        .closed-badge{

            background:#6b7280;

            color:white;
        }

        .verified-badge{

            background:#22c55e;

            color:white;
        }

        .pending-badge{

            background:#f59e0b;

            color:white;
        }

        /* BUTTONS */

        .action-buttons{

            display:flex;

            justify-content:center;

            gap:10px;

            flex-wrap:wrap;
        }

        .verify-btn,
        .reject-btn{

            border:none;

            padding:10px 16px;

            border-radius:12px;

            cursor:pointer;

            color:white;

            font-size:13px;

            font-weight:bold;

            transition:0.3s;
        }

        .verify-btn{

            background:linear-gradient(
                90deg,
                #22c55e,
                #16a34a
            );
        }

        .reject-btn{

            background:linear-gradient(
                90deg,
                #dc2626,
                #b91c1c
            );
        }

        .verify-btn:hover,
        .reject-btn:hover{

            opacity:0.9;

            transform:translateY(-2px);
        }

        /* FOOTER */

        .footer-text{

            text-align:center;

            margin-top:45px;

            color:white;

            font-size:14px;
        }

        /* RESPONSIVE */

        @media(max-width:768px){

            .navbar{

                flex-direction:column;

                gap:20px;
            }

            .nav-links{

                flex-wrap:wrap;

                justify-content:center;
            }

            .page-title{

                font-size:36px;
            }

            .subtitle{

                font-size:16px;

                padding:0 15px;
            }

            .table-wrapper{

                padding:20px;
            }

        }

    </style>

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">

            <div class="logo-icon">

                <i class="fa-solid fa-shield-heart"></i>

            </div>

            <h2>CharityLens Admin</h2>

        </div>

        <div class="nav-links">

            <a href="/admin/dashboard">
                Dashboard
            </a>

            <a href="/admin/cases">
                Manage Cases
            </a>

            <a href="/auth/logout">
                Logout
            </a>

        </div>

    </nav>

    <!-- TITLE -->

    <h1 class="page-title">

        Admin Case Management

    </h1>

    <p class="subtitle">

        Verify submitted fundraising cases, review beneficiary
        requests, and manage platform transparency.

    </p>

    <!-- TABLE -->

    <div class="table-wrapper">

        <table>

            <thead>

                <tr>

                    <th>Title</th>

                    <th>Category</th>

                    <th>Beneficiary</th>

                    <th>Required</th>

                    <th>Collected</th>

                    <th>Status</th>

                    <th>Priority</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                <% cases.forEach(singleCase => { %>

                    <tr>

                        <!-- TITLE -->

                        <td>

                            <%= singleCase.title %>

                        </td>

                        <!-- CATEGORY -->

                        <td>

                            <%= singleCase.category %>

                        </td>

                        <!-- BENEFICIARY -->

                        <td>

                            <%= singleCase.beneficiaryId?.name || 'N/A' %>

                        </td>

                        <!-- REQUIRED -->

                        <td>

                            ₹<%= singleCase.requiredAmount %>

                        </td>

                        <!-- COLLECTED -->

                        <td>

                            ₹<%= singleCase.collectedAmount %>

                        </td>

                        <!-- STATUS -->

                        <td>

                            <% if(singleCase.isClosed) { %>

                                <span class="closed-badge">

                                    Closed

                                </span>

                            <% } else if(singleCase.isVerified) { %>

                                <span class="verified-badge">

                                    Verified

                                </span>

                            <% } else { %>

                                <span class="pending-badge">

                                    Pending

                                </span>

                            <% } %>

                        </td>

                        <!-- PRIORITY -->

                        <td>

                            <%= singleCase.priority %>

                        </td>

                        <!-- ACTIONS -->

                        <td>

                            <div class="action-buttons">

                                <!-- VERIFY -->

                                <% if(!singleCase.isVerified) { %>

                                    <form 
                                        action="/admin/cases/<%= singleCase._id %>/verify" 
                                        method="POST"
                                    >

                                        <button class="verify-btn">

                                            <i class="fa-solid fa-check"></i>

                                            Verify

                                        </button>

                                    </form>

                                <% } %>

                                <!-- REJECT -->

                                <% if(!singleCase.isRejected) { %>

                                    <form 
                                        action="/admin/cases/<%= singleCase._id %>/reject" 
                                        method="POST"
                                    >

                                        <button class="reject-btn">

                                            <i class="fa-solid fa-xmark"></i>

                                            Reject

                                        </button>

                                    </form>

                                <% } %>

                            </div>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

    <!-- FOOTER -->

    <div class="footer-text">

        Protected by end-to-end encryption

    </div>

</body>

</html>