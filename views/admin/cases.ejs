<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Admin Cases</title>

    
    <!-- Font Awesome -->
    <link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">

<style>
  .priority-badge { display:inline-block; padding:3px 10px; border-radius:20px; font-weight:600; font-size:0.78rem; }
  .priority-Low      { background:#f3f4f6; color:#374151; }
  .priority-Medium   { background:#fef9c3; color:#854d0e; }
  .priority-High     { background:#fef3c7; color:#92400e; }
  .priority-Critical { background:#fee2e2; color:#991b1b; }
  .emergency-badge { display:inline-flex; align-items:center; gap:4px; background:#dc2626; color:#fff; padding:3px 10px; border-radius:20px; font-weight:700; font-size:0.78rem; margin-left:4px; }
  .score-text { font-size:0.75rem; color:#888; margin-top:2px; }
</style>
    
</head>

<body>

    <!-- NAVBAR -->

    <%- include('../partials/navbar', {
    currentPage: 'admin-cases',
    user: user
}) %>

    <!-- PAGE NAVIGATION -->
<%- include('../partials/page-navigation') %>
    <!-- TITLE -->

    <h1 class="page-title">

        Admin Case Management

    </h1>

    <p class="subtitle">

        Verify submitted fundraising cases, review beneficiary
        requests, and manage platform transparency.

    </p>

    <!-- TABLE -->

    <div class="table-wrapper">

        <table>

            <thead>

                <tr>

                    <th>Title</th>

                    <th>Category</th>

                    <th>Beneficiary</th>

                    <th>Required</th>

                    <th>Collected</th>

                    <th>Status</th>

                    <th>Priority</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                <% cases.forEach(singleCase => { %>

                    <tr>

                        <!-- TITLE -->

                        <td>

                            <%= singleCase.title %>

                        </td>

                        <!-- CATEGORY -->

                        <td>

                            <%= singleCase.category %>

                        </td>

                        <!-- BENEFICIARY -->

                        <td>

                            <%= singleCase.beneficiaryId?.name || 'N/A' %>

                        </td>

                        <!-- REQUIRED -->

                        <td>

                            ₹<%= Number(singleCase.requiredAmount).toLocaleString() %>
                        </td>

                        <!-- COLLECTED -->

                        <td>

                            ₹<%= Number(singleCase.collectedAmount).toLocaleString() %>

                        </td>

                       <!-- STATUS -->

<td>

    <% if(singleCase.isRejected) { %>

        <span class="rejected-badge">
            Rejected
        </span>

    <% } else if(singleCase.isClosed) { %>

        <span class="closed-badge">
            Closed
        </span>

    <% } else if(singleCase.isVerified) { %>

        <span class="verified-badge">
            Verified
        </span>

    <% } else { %>

        <span class="pending-badge">
            Pending
        </span>

    <% } %>

                        </td>

                        <!-- PRIORITY (new weighted system) -->

                        <td>

    <% if (singleCase.isVerified) { %>

        <span class="priority-badge priority-<%= singleCase.priority || 'Low' %>">
            <%= singleCase.priority || 'Low' %>
        </span>

        <% if (singleCase.emergencyBypass) { %>
            <span class="emergency-badge">
                <i class="fa-solid fa-bolt"></i> EMERGENCY
            </span>
        <% } %>

        <div class="score-text">
            Score: <%= (singleCase.priorityScore || 0).toFixed(2) %>
        </div>

    <% } else { %>

        <span style="color:#aaa;font-size:0.82rem;">Not assigned</span>

    <% } %>

</td>

                        <!-- ACTIONS -->

                        <td>

    <div class="action-buttons">

        <a
            href="/admin/cases/<%= singleCase._id %>"
            class="view-btn"
        >

            <i class="fa-solid fa-eye"></i>

            View

        </a>

        <% if(!singleCase.isRejected) { %>

<button
    type="button"
    class="reject-btn open-reject-modal"
    data-caseid="<%= singleCase._id %>"
    data-title="<%= singleCase.title %>"
>

    <i class="fa-solid fa-xmark"></i>

    Reject

</button>

<% } %>

    </div>

</td>
                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

 <!-- REJECT MODAL -->

<div
    id="rejectModal"
    class="modal-overlay"
    style="display:none;"
>

    <div class="modal-card">

        <h2>Reject Case</h2>

        <p id="modalCaseTitle"></p>

        <form
            id="rejectForm"
            method="POST"
        >

            <label>

                Rejection Reason

            </label>

            <textarea
                name="reason"
                rows="5"
                required
                placeholder="Enter detailed rejection reason..."
            ></textarea>

            <div class="modal-actions">

                <button
                    type="button"
                    id="closeModal"
                    class="view-btn"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="reject-btn"
                >
                    Reject Case
                </button>

            </div>

        </form>

    </div>

</div> 

<script>

const modal =
    document.getElementById(
        'rejectModal'
    );

const rejectForm =
    document.getElementById(
        'rejectForm'
    );

const modalCaseTitle =
    document.getElementById(
        'modalCaseTitle'
    );

document
.querySelectorAll(
    '.open-reject-modal'
)
.forEach(button => {

    button.addEventListener(
        'click',
        () => {

            const caseId =
                button.dataset.caseid;

            const title =
                button.dataset.title;

            rejectForm.action =
                `/admin/cases/${caseId}/reject`;

            modalCaseTitle.innerHTML =
                `<strong>${title}</strong>`;

            modal.style.display =
                'flex';

        }
    );

});

document
.getElementById(
    'closeModal'
)
.addEventListener(
    'click',
    () => {

        modal.style.display =
            'none';

    }
);

window.onclick = function(event) {

    if (event.target === modal) {

        modal.style.display =
            'none';

    }

};

</script>
<%- include('../partials/footer') %>
</body>

</html>
