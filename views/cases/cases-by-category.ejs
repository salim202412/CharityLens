<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title><%= category %> Cases</title>
     <script>
         (function () {
           const saved = localStorage.getItem('theme');
           const theme = saved || 'light';
           document.documentElement.setAttribute('data-theme', theme);
         })();
       </script>

    <link rel="stylesheet"
          href="/css/global.css">

    <link rel="stylesheet"
          href="/css/dashboard.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>

<body>

    <%- include('../partials/navbar') %>

    <%- include('../partials/page-navigation') %>

    <div class="dashboard-page">

        <section class="dashboard-hero">

            <div>

                <h1>

                    <% if(category === 'Masjid') { %>

                         Masjid Cases

                    <% } else if(category === 'DarulUloom') { %>

                         Dar-ul-Uloom Cases

                    <% } else { %>

                         Needy Individual Cases

                    <% } %>

                </h1>

                <p class="dashboard-subtitle">

                    Browse all active fundraising cases
                    in this category.

                </p>

            </div>

        </section>

        <div class="cases-grid">

            <% if(cases.length > 0) { %>

                <% cases.forEach(singleCase => { %>

                    <div
                        class="case-card open-case-modal"
                        
                        data-case-id="<%= singleCase._id %>"
                        data-id="<%= singleCase._id %>"
                        data-title="<%= singleCase.title %>"
                        data-description="<%= singleCase.description %>"
                        data-category="<%= singleCase.category %>"
                        data-required="<%= singleCase.requiredAmount %>"
                        data-collected="<%= singleCase.collectedAmount || 0 %>"
                        data-status="Verified"
                        data-document="<%= singleCase.proofImage || '' %>"
                    >

                        <div class="case-card-top">

                            <div class="case-avatar">

                                <% if(singleCase.category === 'Masjid') { %>

                                    <i class="fa-solid fa-mosque"></i>
                                    

                                <% } else if(singleCase.category === 'DarulUloom') { %>

                                    <i class="fa-solid fa-book-quran"></i>

                                <% } else { %>

                                    <i class="fa-solid fa-user"></i>

                                <% } %>

                            </div>

                            <span class="case-category">

                                <%= singleCase.category %>

                            </span>
                             <span class="priority">

                                <%= singleCase.priority || 'Low' %>

                            </span>

                            <% if (singleCase.emergencyBypass) { %>
                            <span style="background:#dc2626;color:#fff;padding:2px 10px;border-radius:20px;font-size:0.75rem;font-weight:700;margin-left:4px;">
                                <i class="fa-solid fa-bolt"></i> EMERGENCY
                            </span>
                            <% } %>

                        </div>
                         <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap;">
                <span style="font-size:0.85rem;color:#555;">
                    <strong>Priority Score:</strong>
                    <%= (singleCase.priorityScore || 0).toFixed(2) %> / 10
                </span>
                <% if (singleCase.urgency) { %>
                <span style="font-size:0.8rem;color:#888;">
                    U: <%= singleCase.urgency %> &nbsp;·&nbsp;
                    I: <%= singleCase.impact %> &nbsp;·&nbsp;
                    S: <%= singleCase.sustainability %>
                </span>
                <% } %>
            </div>

                        <h3>

                            <%= singleCase.title %>

                        </h3>

                        <p class="case-description">

                            <%= singleCase.description %>

                        </p>

                        <div class="case-progress">

                            <div class="progress-info">

                                <span
    class="collected-amount"
    data-case-id="<%= singleCase._id %>"
>

    ₹<%= (singleCase.collectedAmount || 0).toLocaleString('en-IN') %>

</span>

                                <span
    class="required-amount"
    data-case-id="<%= singleCase._id %>"
>

                                    ₹<%= (singleCase.requiredAmount || 0).toLocaleString('en-IN') %>

                                </span>

                            </div>

                            <%
                            const progress = Math.min(
                                ((singleCase.collectedAmount || 0) /
                                (singleCase.requiredAmount || 1)) * 100,
                                100
                            );
                            %>

                            <div class="progress-bar">

                              <div
    class="progress-fill"
    data-case-id="<%= singleCase._id %>"
    style="width:<%= progress %>%"
></div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <div class="empty-state">

                    <i class="fa-solid fa-folder-open"></i>

                    <h3>

                        No Cases Found

                    </h3>

                    <p>

                        There are currently no active
                        cases in this category.

                    </p>

                </div>

            <% } %>

        </div>

    </div>

    <script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();
socket.on('newDonation', data => {

    console.log(
        'Donation received:',
        data
    );

    const amountElement =
        document.querySelector(

            `.collected-amount[data-case-id="${data.caseId}"]`

        );

    const progressElement =
        document.querySelector(

            `.progress-fill[data-case-id="${data.caseId}"]`

        );

    if (amountElement) {

        amountElement.innerText =

            '₹' +

            Number(
                data.collectedAmount
            ).toLocaleString('en-IN');

    }

    if (progressElement) {

        progressElement.style.width =

            data.progress + '%';

    }

});

</script>
<script src="/js/dark-mode.js" defer></script>
    <%- include('../partials/case-modal') %>

    <%- include('../partials/footer') %>

</body>

</html>