<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Case Details</title>

    <link rel="manifest" href="/manifest.json">

    <meta name="theme-color" content="#7c3aed">

    <!-- Font Awesome -->

   <link rel="stylesheet" href="/css/global.css">
   <link rel="stylesheet" href="/css/dashboard.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

</head>

<body>
    <%- include('../partials/navbar', {
    currentPage: 'cases'
}) %>
<%- include('../partials/page-navigation') %>

    <div class="case-details-page">

    <div class="details-layout">

        <!-- LEFT SIDE -->

        <div class="details-left">

            <div class="top-section">

                <span class="category">

                    <%= foundCase.category %>

                </span>

                <span class="priority">

                    <%= foundCase.priority %>

                </span>

            </div>

            <!-- TITLE -->

            <h1>

                <%= foundCase.title %>

            </h1>

            <!-- DESCRIPTION -->

            <p class="description">

                <%= foundCase.description %>

            </p>

            <!-- PROGRESS -->

            <%

                const progress = Math.min(

                    (

                        (

                            foundCase.collectedAmount /

                            foundCase.requiredAmount

                        ) * 100

                    ).toFixed(1),

                    100

                );

            %>

            <div class="progress-wrapper">

                <div class="progress-info">

                    <span>Donation Progress</span>

                    <span><%= progress %>%</span>

                </div>

                <div class="progress-container">

                    <div

                        class="progress-bar"

                        style="width: <%= progress %>%"

                    >

                    </div>

                </div>

            </div>

            <!-- AMOUNTS -->

            <div class="amounts">

                <p>

                    <strong>Collected:</strong>

                    ₹<%= foundCase.collectedAmount.toLocaleString('en-IN') %>

                </p>

                <p>

                    <strong>Required:</strong>

                    ₹<%= foundCase.requiredAmount.toLocaleString('en-IN') %>

                </p>

            </div>

            <!-- BENEFICIARY -->

            <p class="beneficiary">

                <strong>Beneficiary:</strong>

                <%= foundCase.beneficiaryId.name %>

            </p>

           <!-- DOCUMENT -->

<% if(foundCase.proofImage) { %>

    <div class="proof-section">

        <h3>

            Supporting Document

        </h3>

        <div class="proof-preview">

            <img

                src="<%= foundCase.proofImage %>"

                alt="Proof Image"

                class="proof-thumbnail"

            >

            <button

                class="view-proof-btn"

                onclick="openProofModal()"

            >

                <i class="fa-solid fa-expand"></i>

                View Document

            </button>

        </div>

    </div>

    <!-- MODAL -->

    <div class="proof-modal" id="proofModal">

        <span

            class="close-modal"

            onclick="closeProofModal()"

        >

            &times;

        </span>

        <img

            src="<%= foundCase.proofImage %>"

            class="modal-image"

        >

    </div>

<% } %>
        </div>

        <!-- RIGHT SIDE -->

        <div class="details-right">

            <div class="donation-section">

                <h3>

                    Donate to this Case

                </h3>

                <%

                    const remainingAmount =

                    foundCase.requiredAmount -

                    foundCase.collectedAmount;

                %>

              <input

    type="text"

    id="donationAmount"

    placeholder="Enter donation amount"

    inputmode="numeric"

    autocomplete="off"

>

                <p class="max-amount">

                    Maximum allowed:
                    ₹<%= remainingAmount.toLocaleString('en-IN') %>

                </p>

                <button

                    class="donate-btn"

                    onclick="handleDonation()"

                >

                    <i class="fa-solid fa-hand-holding-heart"></i>

                    Donate Now

                </button>

            </div>

        </div>

    </div>

</div>
   

    <!-- RAZORPAY -->

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <!-- YOUR EXISTING PAYMENT SCRIPT -->

    <script>
        
        function handleDonation() {

    <% if (typeof user === 'undefined' || !user) { %>

        window.location.href = '/auth/login';

        return;

    <% } %>

    <% if (typeof user !== 'undefined' && user && user.role !== 'donor') { %>

        alert('Only donors can donate');

        return;

    <% } %>

    startPayment();
}
        async function startPayment() {

            console.log("Donate button clicked");

            try {

                const amount = Number(document
                    .getElementById('donationAmount')
                    .value
                    .replace(/,/g, ''));

               if (!amount || amount <= 0) {

    alert("Valid donation amount required");

    return;
}

const maxAmount =
    <%= remainingAmount %>;

if (amount > maxAmount) {

    alert(
        `Maximum donation allowed is ₹${maxAmount.toLocaleString('en-IN')}`
    );

    return;
}

                const response = await fetch(

                    '/donate/<%= foundCase._id %>/create-order',

                    {

                        method: 'POST',

                        headers: {

                            'Content-Type':
                                'application/json'

                        },

                        body: JSON.stringify({

                            amount

                        })

                    }

                );

                const data =
                    await response.json();

                if (!response.ok) {

                    alert(
                        data.message ||
                        "Payment failed"
                    );

                    return;

                }

                const options = {

                    key:
                        '<%= razorpayKey %>',

                    amount:
                        data.order.amount,

                    currency:
                        data.order.currency,

                    name:
                        'CharityLens',

                    description:
                        'Donation Payment',

                    order_id:
                        data.order.id,

                    handler: async function (response) {

                        try {

                            const verifyResponse =
                                await fetch(

                                    '/donate/verify',

                                    {

                                        method: 'POST',

                                        headers: {

                                            'Content-Type':
                                                'application/json'

                                        },

                                        body: JSON.stringify({

                                            razorpay_order_id:
                                                response.razorpay_order_id,

                                            razorpay_payment_id:
                                                response.razorpay_payment_id,

                                            razorpay_signature:
                                                response.razorpay_signature

                                        })

                                    }

                                );

                            const verifyData =
                                await verifyResponse.json();

                            if (verifyResponse.ok) {

                                document
    .getElementById('successModal')
    .classList.add('active');

                            } else {

                                alert(

                                    verifyData.message ||

                                    "Payment verification failed"

                                );

                            }

                        } catch (error) {

                            console.error(error);

                            alert(
                                "Verification failed"
                            );

                        }

                    },

                    modal: {

                        ondismiss: function () {

                            console.log("Payment cancelled");

                        }

                    }

                };

                const rzp =
                    new Razorpay(options);

                rzp.open();

            } catch (error) {

                console.error(error);

                showErrorModal("Payment failed");

            }

        }

    </script>

    <script>

    function openProofModal() {

        document
            .getElementById('proofModal')
            .classList.add('active');
    }

    function closeProofModal() {

        document
            .getElementById('proofModal')
            .classList.remove('active');
    }

    function closeSuccessModal() {

    window.location.href =
        '/donor/dashboard';
}

    const proofModal =
    document.getElementById('proofModal');

if (proofModal) {

    proofModal.addEventListener('click', function(e) {

        if (e.target === proofModal) {

            closeProofModal();

        }

    });

}

</script>

    <!-- SERVICE WORKER -->

    <script>

        if ('serviceWorker' in navigator) {

            window.addEventListener('load', () => {

                navigator.serviceWorker

                    .register('/sw.js')

                    .then(() => {

                        console.log(
                            'Service Worker Registered'
                        );

                    })

                    .catch(error => {

                        console.log(error);

                    });

            });

        }

    </script>
    <script>

    const donationInput =
        document.getElementById('donationAmount');

    donationInput.addEventListener('input', function(e) {

        let value =
            e.target.value.replace(/,/g, '');

        value =
            value.replace(/\D/g, '');
        value = 
            value.replace(/^0+/, '');

        if (!value) {

            e.target.value = '';

            return;

        }

        e.target.value =
            Number(value).toLocaleString('en-IN');

    });

</script>

<!-- SUCCESS MODAL -->

<div class="success-modal" id="successModal">

    <div class="success-box">

        <div class="success-icon">

            <i class="fa-solid fa-circle-check"></i>

        </div>

        <h2>Donation Successful!</h2>

        <p>

            Thank you for supporting this cause.
            Your contribution will help make a real impact.

        </p>

        <button onclick="closeSuccessModal()">

            Continue

        </button>

    </div>

</div>
<%- include('../partials/footer') %>
</body>

</html>