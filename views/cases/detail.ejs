<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Case Details</title>

    <link rel="manifest" href="/manifest.json">

    <meta name="theme-color" content="#7c3aed">

    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, sans-serif;
        }

        body{

            min-height:100vh;

            background: linear-gradient(
                180deg,
                #5a5df0 0%,
                #8f2fff 55%,
                #ff3ba7 100%
            );

            padding:40px 20px;
        }

        /* MAIN CARD */

        .container{

            max-width:900px;

            margin:auto;

            background:rgba(255,255,255,0.12);

            backdrop-filter: blur(14px);

            border-radius:25px;

            padding:35px;

            color:white;

            box-shadow:0 10px 40px rgba(0,0,0,0.2);
        }

        /* TOP */

        .top-section{

            display:flex;

            justify-content:space-between;

            align-items:center;

            margin-bottom:25px;

            flex-wrap:wrap;

            gap:15px;
        }

        .category{

            display:inline-block;

            background:linear-gradient(
                90deg,
                #4f46e5,
                #a200ff
            );

            padding:10px 18px;

            border-radius:30px;

            font-size:14px;

            font-weight:bold;
        }

        .priority{

            background:crimson;

            padding:10px 18px;

            border-radius:30px;

            font-size:14px;

            font-weight:bold;
        }

        /* TITLE */

        h1{

            font-size:42px;

            margin-bottom:20px;

            line-height:1.3;
        }

        /* DESCRIPTION */

        .description{

            color:#f3f4f6;

            line-height:1.8;

            font-size:17px;

            margin-bottom:30px;
        }

        /* IMAGE */

        .proof-image{

            width:100%;

            max-height:420px;

            object-fit:cover;

            border-radius:18px;

            margin-top:25px;

            box-shadow:0 8px 20px rgba(0,0,0,0.2);
        }

        /* PROGRESS */

        .progress-wrapper{

            margin-top:30px;
        }

        .progress-info{

            display:flex;

            justify-content:space-between;

            margin-bottom:12px;

            font-size:15px;
        }

        .progress-container{

            width:100%;

            height:22px;

            background:rgba(255,255,255,0.2);

            border-radius:30px;

            overflow:hidden;
        }

        .progress-bar{

            height:100%;

            background:linear-gradient(
                90deg,
                #22c55e,
                #16a34a
            );

            text-align:center;

            line-height:22px;

            font-size:12px;

            font-weight:bold;

            border-radius:30px;
        }

        /* AMOUNTS */

        .amounts{

            margin-top:25px;

            line-height:2;

            font-size:16px;
        }

        .amounts strong{

            color:white;
        }

        /* BENEFICIARY */

        .beneficiary{

            margin-top:18px;

            font-size:16px;

            color:#f3f4f6;
        }

        /* DONATION SECTION */

        .donation-section{

            margin-top:40px;

            background:rgba(255,255,255,0.08);

            padding:25px;

            border-radius:18px;
        }

        .donation-section h3{

            margin-bottom:20px;

            font-size:28px;
        }

        input{

            width:100%;

            padding:15px;

            border:none;

            outline:none;

            border-radius:12px;

            background:rgba(255,255,255,0.9);

            font-size:15px;

            margin-bottom:12px;
        }

        .max-amount{

            color:#e5e7eb;

            font-size:14px;

            margin-bottom:20px;
        }

        /* BUTTON */

        .donate-btn{

            width:100%;

            border:none;

            padding:16px;

            border-radius:14px;

            background:linear-gradient(
                90deg,
                #4f46e5,
                #a200ff
            );

            color:white;

            font-size:17px;

            font-weight:bold;

            cursor:pointer;

            transition:0.3s;
        }

        .donate-btn:hover{

            opacity:0.92;

            transform:translateY(-2px);
        }

        /* FOOTER */

        .footer{

            text-align:center;

            margin-top:30px;

            color:white;

            font-size:14px;
        }

        /* RESPONSIVE */

        @media(max-width:768px){

            h1{

                font-size:32px;
            }

            .container{

                padding:25px;
            }

        }

    </style>

</head>

<body>

    <div class="container">

        <!-- TOP -->

        <div class="top-section">

            <span class="category">

                <%= foundCase.category %>

            </span>

            <span class="priority">

                <%= foundCase.priority %>

            </span>

        </div>

        <!-- TITLE -->

        <h1>

            <%= foundCase.title %>

        </h1>

        <!-- DESCRIPTION -->

        <p class="description">

            <%= foundCase.description %>

        </p>

        <!-- PROGRESS -->

        <%

            const progress = Math.min(

                (
                    (
                        foundCase.collectedAmount /

                        foundCase.requiredAmount
                    ) * 100
                ).toFixed(1),

                100

            );

        %>

        <div class="progress-wrapper">

            <div class="progress-info">

                <span>Donation Progress</span>

                <span><%= progress %>%</span>

            </div>

            <div class="progress-container">

                <div

                    class="progress-bar"

                    style="width: <%= progress %>%"

                >

                    <%= progress %>%

                </div>

            </div>

        </div>

        <!-- AMOUNTS -->

        <div class="amounts">

            <p>

                <strong>Collected:</strong>

                ₹<%= foundCase.collectedAmount %>

            </p>

            <p>

                <strong>Required:</strong>

                ₹<%= foundCase.requiredAmount %>

            </p>

        </div>

        <!-- BENEFICIARY -->

        <p class="beneficiary">

            <strong>Beneficiary:</strong>

            <%= foundCase.beneficiaryId.name %>

        </p>

        <!-- IMAGE -->

        <% if(foundCase.proofImage) { %>

            <img

                src="<%= foundCase.proofImage %>"

                alt="Proof Image"

                class="proof-image"

            >

        <% } %>

        <!-- DONATION SECTION -->

        <div class="donation-section">

            <h3>

                Donate to this Case

            </h3>

            <%

                const remainingAmount =

                foundCase.requiredAmount -

                foundCase.collectedAmount;

            %>

            <input

                type="number"

                id="donationAmount"

                placeholder="Enter donation amount"

                min="1"

                max="<%= remainingAmount %>"

            >

            <p class="max-amount">

                Maximum allowed:
                ₹<%= remainingAmount %>

            </p>

            <button

                class="donate-btn"

                onclick="startPayment()"

            >

                <i class="fa-solid fa-hand-holding-heart"></i>

                Donate Now

            </button>

        </div>

    </div>

    <!-- FOOTER -->

    <div class="footer">

        Protected by end-to-end encryption

    </div>

    <!-- RAZORPAY -->

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <!-- YOUR EXISTING PAYMENT SCRIPT -->

    <script>

        async function startPayment() {

            console.log("Donate button clicked");

            try {

                const amount = document
                    .getElementById('donationAmount')
                    .value;

                if (!amount || amount <= 0) {

                    alert("Valid donation amount required");

                    return;

                }

                const response = await fetch(

                    '/donate/<%= foundCase._id %>/create-order',

                    {

                        method: 'POST',

                        headers: {

                            'Content-Type':
                                'application/json'

                        },

                        body: JSON.stringify({

                            amount

                        })

                    }

                );

                const data =
                    await response.json();

                if (!response.ok) {

                    alert(
                        data.message ||
                        "Payment failed"
                    );

                    return;

                }

                const options = {

                    key:
                        '<%= razorpayKey %>',

                    amount:
                        data.order.amount,

                    currency:
                        data.order.currency,

                    name:
                        'CharityLens',

                    description:
                        'Donation Payment',

                    order_id:
                        data.order.id,

                    handler: async function (response) {

                        try {

                            const verifyResponse =
                                await fetch(

                                    '/donate/verify',

                                    {

                                        method: 'POST',

                                        headers: {

                                            'Content-Type':
                                                'application/json'

                                        },

                                        body: JSON.stringify({

                                            razorpay_order_id:
                                                response.razorpay_order_id,

                                            razorpay_payment_id:
                                                response.razorpay_payment_id,

                                            razorpay_signature:
                                                response.razorpay_signature

                                        })

                                    }

                                );

                            const verifyData =
                                await verifyResponse.json();

                            if (verifyResponse.ok) {

                                alert(
                                    "✅ Donation successful!"
                                );

                                location.reload();

                            } else {

                                alert(

                                    verifyData.message ||

                                    "Payment verification failed"

                                );

                            }

                        } catch (error) {

                            console.error(error);

                            alert(
                                "Verification failed"
                            );

                        }

                    },

                    modal: {

                        ondismiss: function () {

                            alert(
                                "❌ Payment cancelled"
                            );

                        }

                    }

                };

                const rzp =
                    new Razorpay(options);

                rzp.open();

            } catch (error) {

                console.error(error);

                alert("Payment failed");

            }

        }

    </script>

    <!-- SERVICE WORKER -->

    <script>

        if ('serviceWorker' in navigator) {

            window.addEventListener('load', () => {

                navigator.serviceWorker

                    .register('/sw.js')

                    .then(() => {

                        console.log(
                            'Service Worker Registered'
                        );

                    })

                    .catch(error => {

                        console.log(error);

                    });

            });

        }

    </script>

</body>

</html>