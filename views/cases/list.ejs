<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0"/>

    <title>All Cases</title>
     <script>
         (function () {
           const saved = localStorage.getItem('theme');
           const theme = saved || 'light';
           document.documentElement.setAttribute('data-theme', theme);
         })();
       </script>

    <link rel="manifest" href="/manifest.json">

    <meta name="theme-color" content="#7c3aed">

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

</head>

<body>

    <%- include('../partials/navbar', {
        currentPage: 'cases',
        user: user
    }) %>

    <%- include('../partials/page-navigation') %>

    <div class="page-container">

        <h1 class="page-title">

            Active Fundraising Cases

        </h1>

        <p class="subtitle">

            Explore verified fundraising campaigns
            and support people in need.

        </p>

        <div class="cases-grid">

            <% if (cases && cases.length > 0) { %>

                <% cases.forEach(singleCase => { %>

                    <div class="case-card">

                        <div class="top-section">

                            <span class="category">

                                <%= singleCase.category %>

                            </span>

                            <span class="priority">

                                <%= singleCase.priority || 'Low' %>

                            </span>

                            <% if (singleCase.emergencyBypass) { %>
                            <span style="background:#dc2626;color:#fff;padding:2px 10px;border-radius:20px;font-size:0.75rem;font-weight:700;margin-left:4px;">
                                <i class="fa-solid fa-bolt"></i> EMERGENCY
                            </span>
                            <% } %>

                        </div>

                        <h2>

                            <%= singleCase.title %>

                        </h2>

                        <p class="description">

                            <%= singleCase.description.substring(0, 120) %>...

                        </p>

                        <%

                            const progress = Math.min(

                                (

                                    (

                                        singleCase.collectedAmount /

                                        singleCase.requiredAmount

                                    ) * 100

                                ).toFixed(1),

                                100

                            );

                        %>

                        <div class="progress-wrapper">

                            <div class="progress-info">

                                <span>

                                    ₹<%= singleCase.collectedAmount.toLocaleString('en-IN') %>

                                </span>

                                <span>

                                    ₹<%= singleCase.requiredAmount.toLocaleString('en-IN') %>

                                </span>

                            </div>
                            
                            <span id="progressPercent">
                                 <%= progress %>%
                                   </span>
                            <div class="progress-container">
                                
                                <div
                                id="progressBar"
                                class="progress-fill"
                                style="width:<%= progress %>%"
                                ></div>

                            </div>

                        </div>

                        <div style="margin-top: 20px;">

                            <a
                                href="/cases-view/<%= singleCase._id %>"
                                class="btn btn-primary"
                            >

                                View Details

                            </a>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <div class="empty-state">

                    <i class="fa-solid fa-folder-open"></i>

                    <h2>No Cases Available</h2>

                    <p>

                        There are currently no verified
                        fundraising cases available.

                    </p>

                </div>

            <% } %>

        </div>

    </div>
    <script src="/js/dark-mode.js" defer></script>
<%- include('../partials/footer') %>
</body>

</html>