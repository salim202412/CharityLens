<!-- CASE DETAILS MODAL -->

<div
    id="caseModal"
    class="case-modal-overlay"
    style="display:none;"
>

    <div class="case-modal-content">

        <button
            id="closeCaseModal"
            class="close-modal-btn"
        >

            <i class="fa-solid fa-xmark"></i>

        </button>

        <div id="modalContent">

        </div>

    </div>

</div>

<script>

const modal =
    document.getElementById(
        'caseModal'
    );

const modalContent =
    document.getElementById(
        'modalContent'
    );

document
.querySelectorAll(
    '.open-case-modal'
)
.forEach(card => {

    card.addEventListener(
        'click',
        () => {
            const caseId =
    card.dataset.id;



            const title =
                card.dataset.title;

            const description =
                card.dataset.description;

            const category =
                card.dataset.category;

            const required =
                Number(
                    card.dataset.required
                ).toLocaleString();

            const collected =
                Number(
                    card.dataset.collected
                ).toLocaleString();

            const status =
                card.dataset.status;

            const reason =
                card.dataset.reason;

            const documentImage =
                card.dataset.document;

            modalContent.innerHTML = `

                <h1>${title}</h1>

                <br>

                <p>

                    <strong>Status:</strong>

                    ${status}

                </p>

                <br>

                    <strong>Category:</strong>

                    ${category}

                </p>
                

                <br>

                <p>

                    <strong>Description:</strong>

                    ${description}

                </p>

                <br>

                <p>

                    <strong>Raised:</strong>

                    ₹${collected}

                </p>

                <br>

                <p>

                    <strong>Required:</strong>

                    ₹${required}

                </p>

                ${
                    reason
                    ?
                    `
                    <br>

                    <div class="rejection-box">

                        <strong>
                            Rejection Reason:
                        </strong>

                        <p>
                            ${reason}
                        </p>

                    </div>
                    `
                    :
                    ''
                }

                ${
                    documentImage
                    ?
                    `
                    <br>

                    <img
                        src="${documentImage}"
                        style="
                            width:100%;
                            max-width:500px;
                            border-radius:12px;
                        "
                    >
                    `
                    :
                    ''
                }

                    <br>

                    <div class="modal-actions">

    <a
        href="/cases-view/${caseId}"
        class="btn btn-primary"
    >
        Donate Now
    </a>

</div>

            `;

            modal.style.display =
                'flex';

        }
    );

});

document
.getElementById(
    'closeCaseModal'
)
.addEventListener(
    'click',
    () => {

        modal.style.display =
            'none';

    }
);

window.addEventListener(
    'click',
    e => {

        if(
            e.target === modal
        ){

            modal.style.display =
                'none';

        }

    }
);


</script>

</div>