<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Beneficiary Dashboard</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

</head>

<body>

    <!-- NAVBAR -->
    <%- include('../partials/navbar', {
        currentPage: 'dashboard'
    }) %>

    <!-- PAGE NAVIGATION -->
    <%- include('../partials/page-navigation') %>

    

    <div class="dashboard-page">

        <!-- HERO -->
        <section class="dashboard-hero">

            <div>

                <p class="dashboard-tag">
                    BENEFICIARY PORTAL
                </p>

                <h1>
                    Welcome Back,
                    <span>
                        <%= typeof user !== 'undefined' && user && user.name
                            ? user.name
                            : 'User'
                        %>
                    </span>
                </h1>

                <p class="dashboard-subtitle">
                    Track your submitted cases, monitor donations,
                    and manage verification progress.
                </p>

            </div>

            <div class="hero-actions">

                <a href="/submit-case" class="btn btn-primary">
                    Submit New Case
                </a>

            </div>

        </section>

       <div class="dashboard-grid">

    <a
    href="/beneficiary/my-cases?status=active"
    class="dashboard-card-link"
>

    <div class="card">

        <div class="card-icon">

            <i class="fa-solid fa-folder-open"></i>

        </div>

        <h2>

            <%= activeCases || 0 %>

        </h2>

        <p>

            Active Cases

        </p>

    </div>

</a>

    <!-- DONATIONS -->
   
    <div class="card">

        <div class="card-icon">

            <i class="fa-solid fa-hand-holding-heart"></i>

        </div>

        <h2>

            ₹<%= (totalRaised || 0).toLocaleString('en-IN') %>

        </h2>

        <p>

            Total Donations

        </p>

    </div>
</a>

    <!-- PENDING -->
     <a
    href="/beneficiary/my-cases?status=pending"
    class="dashboard-card-link"
>
    
    <div class="card">

        <div class="card-icon">

            <i class="fa-solid fa-clock"></i>

        </div>

        <h2>

            <%= pendingCases || 0 %>

        </h2>

        <p>

            Pending Verification

        </p>

    </div>
     </a>

    <!-- APPROVED -->
      <a
    href="/beneficiary/my-cases?status=approved"
    class="dashboard-card-link"
>

    <div class="card">

        <div class="card-icon">

            <i class="fa-solid fa-circle-check"></i>

        </div>

        <h2>

            <%= approvedCases || 0 %>

        </h2>

        <p>

            Approved Cases

        </p>

    </div>
</a>
    <!-- REJECTED -->
<a
    href="/beneficiary/my-cases?status=rejected"
    class="dashboard-card-link"
>
    <div class="card">

    <div class="card-icon">

        <i class="fa-solid fa-circle-xmark"></i>

    </div>

    <h2>

        <%= rejectedCases || 0 %>

    </h2>

    <p>

        Rejected Cases

    </p>

</div>
</a>    

</div>

        <!-- RECENT CASES -->
        <section class="dashboard-section">

            <div class="section-header">

                <h2>Your Recent Cases</h2>

                <a href="/beneficiary/my-cases">
                    View All
                </a>

            </div>

            <div class="cases-grid">

                <% if (cases && cases.length > 0) { %>

                    <% cases.forEach(singleCase => { %>

    <div
    class="case-card open-case-modal
    <%= singleCase.isRejected ? 'rejected-case' : '' %>"

    data-title="<%= singleCase.title %>"
    
    data-id="<%= singleCase._id %>"

    data-description="<%= singleCase.description %>"

    data-category="<%= singleCase.category %>"

    data-required="<%= singleCase.requiredAmount %>"

    data-collected="<%= singleCase.collectedAmount || 0 %>"

    data-status="<%= singleCase.isRejected
        ? 'Rejected'
        : singleCase.isVerified
        ? 'Verified'
        : 'Pending Verification'
    %>"

    data-reason="<%= singleCase.rejectionReason || '' %>"

    data-document="<%= singleCase.proofImage || '' %>"
>

                            <div class="case-card-top">

                               <div class="case-avatar">

<% if(singleCase.category === 'Masjid') { %>

    <i class="fa-solid fa-mosque"></i>

<% } else if(singleCase.category === 'DarulUloom') { %>

    <i class="fa-solid fa-book-quran"></i>

<% } else { %>

    <i class="fa-solid fa-user"></i>

<% } %>

</div>

                                <span class="case-category">
                                    <%= singleCase.category %>
                                </span>

                            </div>

                            <h3>
                                <%= singleCase.title %>
                            </h3>

                            <p class="case-description">
                                <%= singleCase.description %>
                            </p>

                            <div class="case-progress">

                                <div class="progress-info">

                                    <span>
                                        ₹<%= (singleCase.collectedAmount || 0)
                                        .toLocaleString('en-IN') %>
                                    </span>

                                    <span>
                                        ₹<%= (singleCase.requiredAmount || 0)
                                        .toLocaleString('en-IN') %>
                                    </span>

                                </div>

                                <%
                                const progress = Math.min(
                                    ((singleCase.collectedAmount || 0) /
                                    (singleCase.requiredAmount || 1)) * 100,
                                    100
                                );
                                %>

                                <div class="progress-bar">

                                    <div
                                        class="progress-fill"
                                        style="width: <%= progress %>%"
                                    ></div>

                                </div>

                            </div>

                            <div class="priority-wrapper">

                                <span class="priority-label">
                                    <%= singleCase.priority || 'Medium' %>
                                </span>

                                <div class="priority-battery">

                                    <div class="
                                        battery-level
                                        priority-<%= (singleCase.priority || 'medium')
                                        .toLowerCase() %>
                                    "></div>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                <% } else { %>

                    <div class="empty-state">

                        <i class="fa-solid fa-folder-open"></i>

                        <h3>No Cases Yet</h3>

                        <p>
                            You haven't submitted any cases yet.
                        </p>

                        <a href="/submit-case" class="btn btn-primary">
                            Submit First Case
                        </a>

                    </div>

                <% } %>

            </div>

        </section>

    </div>

<!-- CASE MODAL -->
    <%- include('../partials/case-modal') %>
<%- include('../partials/footer') %>
</body>

</html>