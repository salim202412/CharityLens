<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Beneficiary Dashboard</title>

    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, sans-serif;
        }

        body{

            min-height:100vh;

            background: linear-gradient(
                180deg,
                #5a5df0 0%,
                #8f2fff 55%,
                #ff3ba7 100%
            );

            padding-bottom:40px;
        }

        /* NAVBAR */

        .navbar{

            width:100%;

            padding:20px 8%;

            display:flex;

            justify-content:space-between;

            align-items:center;

            background:rgba(255,255,255,0.08);

            backdrop-filter: blur(10px);

            margin-bottom:50px;
        }

        .logo{

            display:flex;
            align-items:center;
            gap:10px;
        }

        .logo-icon{

            width:45px;
            height:45px;

            border-radius:50%;

            background:rgba(255,255,255,0.15);

            display:flex;
            justify-content:center;
            align-items:center;

            color:white;
            font-size:18px;
        }

        .logo h2{

            color:white;
            font-size:28px;
        }

        .nav-links{

            display:flex;
            align-items:center;
            gap:25px;
        }

        .nav-links a{

            color:white;

            text-decoration:none;

            font-weight:600;

            transition:0.3s;
        }

        .nav-links a:hover{

            opacity:0.8;
        }

        /* PAGE TITLE */

        .page-title{

            text-align:center;

            color:white;

            font-size:48px;

            margin-bottom:15px;
        }

        .subtitle{

            text-align:center;

            color:#f3f4f6;

            font-size:18px;

            margin-bottom:45px;
        }

        /* GRID */

        .cases-grid{

            width:90%;

            max-width:1400px;

            margin:auto;

            display:grid;

            grid-template-columns:
                repeat(auto-fit, minmax(340px, 1fr));

            gap:30px;
        }

        /* CARD */

        .case-card{

            background:rgba(255,255,255,0.12);

            backdrop-filter: blur(14px);

            border-radius:24px;

            padding:28px;

            color:white;

            box-shadow:0 10px 35px rgba(0,0,0,0.2);

            transition:0.3s;
        }

        .case-card:hover{

            transform:translateY(-5px);
        }

        /* TITLE */

        .case-card h2{

            font-size:28px;

            margin-bottom:18px;

            line-height:1.4;
        }

        /* CATEGORY */

        .category{

            margin-bottom:18px;

            color:#f3f4f6;

            line-height:1.7;
        }

        /* STATUS */

        .status{

            display:inline-block;

            padding:9px 18px;

            border-radius:30px;

            color:white;

            font-size:13px;

            font-weight:bold;

            text-transform:uppercase;

            margin-bottom:20px;
        }

        .verified{

            background:#22c55e;
        }

        .pending{

            background:#f59e0b;
        }

        .closed{

            background:#6b7280;
        }

        .rejected{

            background:crimson;
        }

        /* PROGRESS */

        .progress-wrapper{

            margin-top:10px;
        }

        .progress-info{

            display:flex;

            justify-content:space-between;

            margin-bottom:10px;

            font-size:14px;
        }

        .progress-container{

            width:100%;

            height:20px;

            background:rgba(255,255,255,0.2);

            border-radius:20px;

            overflow:hidden;
        }

        .progress-bar{

            height:100%;

            background:linear-gradient(
                90deg,
                #22c55e,
                #16a34a
            );

            text-align:center;

            color:white;

            line-height:20px;

            font-size:12px;

            font-weight:bold;

            border-radius:20px;
        }

        /* AMOUNTS */

        .amounts{

            margin-top:22px;

            line-height:2;

            font-size:15px;
        }

        .amounts strong{

            color:white;
        }

        /* FOOTER */

        .footer-text{

            text-align:center;

            margin-top:50px;

            color:white;

            font-size:14px;
        }

        /* RESPONSIVE */

        @media(max-width:768px){

            .navbar{

                flex-direction:column;

                gap:20px;
            }

            .nav-links{

                flex-wrap:wrap;

                justify-content:center;
            }

            .page-title{

                font-size:36px;
            }

            .subtitle{

                font-size:16px;

                padding:0 15px;
            }

        }

    </style>

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">

            <div class="logo-icon">

                <i class="fa-solid fa-heart"></i>

            </div>

            <h2>CharityLens</h2>

        </div>

        <div class="nav-links">

            <a href="/beneficiary/dashboard">
                Dashboard
            </a>

            <a href="/submit-case">
                Submit Case
            </a>

            <a href="/cases/my">
                My Cases
            </a>

            <a href="/auth/logout">
                Logout
            </a>

        </div>

    </nav>

    <!-- PAGE TITLE -->

    <h1 class="page-title">

        Beneficiary Dashboard

    </h1>

    <p class="subtitle">

        Manage your submitted cases, track donations,
        and monitor verification progress.

    </p>

    <!-- GRID -->

    <div class="cases-grid">

        <% cases.forEach(singleCase => { %>

            <div class="case-card">

                <!-- TITLE -->

                <h2>

                    <%= singleCase.title %>

                </h2>

                <!-- CATEGORY -->

                <p class="category">

                    <strong>Category:</strong>

                    <%= singleCase.category %>

                </p>

                <!-- STATUS -->

                <% if(singleCase.isRejected) { %>

                    <span class="status rejected">

                        Rejected

                    </span>

                <% } else if(singleCase.isClosed) { %>

                    <span class="status closed">

                        Closed

                    </span>

                <% } else if(singleCase.isVerified) { %>

                    <span class="status verified">

                        Verified

                    </span>

                <% } else { %>

                    <span class="status pending">

                        Pending

                    </span>

                <% } %>

                <!-- PROGRESS -->

                <% 

                    const progress = Math.min(

                        (
                            (
                                singleCase.collectedAmount /

                                singleCase.requiredAmount
                            ) * 100
                        ).toFixed(1),

                        100
                    );

                %>

                <div class="progress-wrapper">

                    <div class="progress-info">

                        <span>Donation Progress</span>

                        <span><%= progress %>%</span>

                    </div>

                    <div class="progress-container">

                        <div
                            class="progress-bar"
                            style="width: <%= progress %>%"
                        >

                            <%= progress %>%

                        </div>

                    </div>

                </div>

                <!-- AMOUNTS -->

                <div class="amounts">

                    <p>

                        <strong>Collected:</strong>

                        ₹<%= singleCase.collectedAmount %>

                    </p>

                    <p>

                        <strong>Required:</strong>

                        ₹<%= singleCase.requiredAmount %>

                    </p>

                </div>

            </div>

        <% }) %>

    </div>

    <!-- FOOTER -->

    <div class="footer-text">

        Protected by end-to-end encryption

    </div>

</body>

</html>