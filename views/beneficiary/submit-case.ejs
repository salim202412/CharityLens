<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Submit Case</title>
     <script>
         (function () {
           const saved = localStorage.getItem('theme');
           const theme = saved || 'light';
           document.documentElement.setAttribute('data-theme', theme);
         })();
       </script>

    <!-- Font Awesome -->

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

       

</head>

<body>

   <%- include('../partials/navbar', {
    currentPage: 'submit-case',
    user: user
}) %>
<%- include('../partials/page-navigation') %>

    <!-- MAIN -->

    <div class="submit-page">
        <div class="submit-layout">
            <div class="submit-info">

    <span class="submit-tag">
        FUNDRAISING PORTAL
    </span>

    <h1>
        Start a Verified
        Fundraising Campaign
    </h1>

    <p>
        Share your story, upload proof,
        and receive transparent support
        from donors around the world.
    </p>

    <div class="info-points">

        <div class="info-item">
            <i class="fa-solid fa-circle-check"></i>
            Secure & verified fundraising
        </div>

        <div class="info-item">
            <i class="fa-solid fa-shield-heart"></i>
            Admin reviewed submissions
        </div>

        

    </div>

</div>
    <div class="submit-form-section">

        <div class="form-card">

            <!-- ICON -->

            <div class="icon-box">

                <i class="fa-solid fa-file-circle-plus"></i>

            </div>

            <!-- TITLE -->

            <h1>

                Submit New Case

            </h1>

            <p class="subtitle">

                Create a verified fundraising case and
                receive support from donors securely.

            </p>

            <!-- FORM -->

            <form
                action="/cases/submit"
                method="POST"
                enctype="multipart/form-data"
            >

                <!-- TITLE -->

                <div class="form-group">

                    <label>Case Title</label>

                    <div class="input-box">

                        <i class="fa-solid fa-heading"></i>

                        <input
                            type="text"
                            name="title"
                            placeholder="Enter case title"
                            required
                        >

                    </div>

                </div>

                <!-- DESCRIPTION -->

                <div class="form-group">

                    <label>Case Description</label>

                    <div class="input-box">

                        <i class="fa-solid fa-align-left"></i>

                        <textarea
                            name="description"
                            placeholder="Enter case description"
                            rows="5"
                            required
                        ></textarea>

                    </div>

                </div>

                <!-- CATEGORY -->

                <div class="form-group">

                    <label>Select Category</label>

                    <div class="input-box">

                        <i class="fa-solid fa-layer-group"></i>

                        <select
                            name="category"
                            required
                        >

                            <option value="">
                                Select Category
                            </option>

                            <option value="Masjid">
                                Masjid
                            </option>

                            <option value="DarulUloom">
                                DarulUloom
                            </option>

                            <option value="Individual">
                                Individual
                            </option>

                        </select>

                    </div>

                </div>

                <!-- AMOUNT -->

                <div class="form-group">

                    <label>Required Amount</label>

                    <div class="amount-input">

    <span class="currency-symbol">
        ₹
    </span>

    <input
        type="text"
        id="requiredAmount"
        name="requiredAmount"
        placeholder="Enter required amount"
        autocomplete="off"
        required
    >

</div>

                </div>

                <!-- IMAGE -->

                <div class="form-group">

                    <label>Proof Image</label>

                   <div class="form-group">

    <label></label>

    <div class="upload-area" id="uploadArea">

        <input
            type="file"
            name="proofImage"
            id="proofImage"
            accept="image/*"
            required
            hidden
        >

        <div class="upload-content">

            <i class="fa-solid fa-cloud-arrow-up"></i>

            <h3>Upload Proof Image</h3>

            <p>
                Drag & drop or click to browse
            </p>

            <span>
                PNG, JPG supported
            </span>

        </div>

        <img
            id="previewImage"
            class="preview-image"
        >

    </div>

</div>

                </div>

                <!-- BUTTON -->

                <button
                    type="submit"
                    class="submit-btn"
                >

                    <h4>Submit Case</h4>

                </button>

            </form>

        </div>
        </div>
    </div>

    <script>

const uploadArea =
document.getElementById('uploadArea');

const fileInput =
document.getElementById('proofImage');

const previewImage =
document.getElementById('previewImage');


uploadArea.addEventListener('click', () => {

    fileInput.click();

});


fileInput.addEventListener('change', e => {

    const file = e.target.files[0];

    if (!file) return;

    const reader = new FileReader();

    reader.onload = event => {

        previewImage.src =
            event.target.result;

        previewImage.style.display = 'block';

    };

    reader.readAsDataURL(file);

});

const amountInput =
document.getElementById('requiredAmount');

amountInput.addEventListener('input', e => {

    let value =
    e.target.value.replace(/,/g, '');

    if (!value) {

        e.target.value = '';
        return;
    }

    value = value.replace(/\D/g, '');

    const number = Number(value);

    if (isNaN(number)) {
        return;
    }

    e.target.value =
        number.toLocaleString('en-IN');

});

</script>
</body>
<script src="/js/dark-mode.js" defer></script>
<%- include('../partials/footer') %>

</html>