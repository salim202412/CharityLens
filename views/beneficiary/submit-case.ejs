<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Submit Case</title>

    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, sans-serif;
        }

        body{

            min-height:100vh;

            background: linear-gradient(
                180deg,
                #5a5df0 0%,
                #8f2fff 55%,
                #ff3ba7 100%
            );

            padding-bottom:40px;
        }

        /* NAVBAR */

        .navbar{

            width:100%;

            padding:20px 8%;

            display:flex;

            justify-content:space-between;

            align-items:center;

            background:rgba(255,255,255,0.08);

            backdrop-filter: blur(10px);

            margin-bottom:60px;
        }

        .logo{

            display:flex;
            align-items:center;
            gap:10px;
        }

        .logo-icon{

            width:45px;
            height:45px;

            border-radius:50%;

            background:rgba(255,255,255,0.15);

            display:flex;
            justify-content:center;
            align-items:center;

            color:white;
            font-size:18px;
        }

        .logo h2{

            color:white;
            font-size:28px;
        }

        .nav-links{

            display:flex;
            align-items:center;
            gap:25px;
        }

        .nav-links a{

            color:white;

            text-decoration:none;

            font-weight:600;

            transition:0.3s;
        }

        .nav-links a:hover{

            opacity:0.8;
        }

        /* MAIN CONTAINER */

        .main-container{

            width:100%;
            max-width:650px;

            margin:auto;

            padding:0 20px;
        }

        /* FORM CARD */

        .form-card{

            background:rgba(255,255,255,0.12);

            backdrop-filter: blur(14px);

            border-radius:24px;

            padding:70px 35px 35px;

            position:relative;

            color:white;

            box-shadow:0 10px 35px rgba(0,0,0,0.2);
        }

        /* TOP ICON */

        .icon-box{

            width:75px;
            height:75px;

            border-radius:50%;

            background:linear-gradient(
                135deg,
                #4f46e5,
                #a200ff
            );

            display:flex;

            justify-content:center;

            align-items:center;

            font-size:28px;

            color:white;

            position:absolute;

            top:-38px;

            left:50%;

            transform:translateX(-50%);

            box-shadow:0 10px 25px rgba(0,0,0,0.25);
        }

        /* TITLE */

        h1{

            text-align:center;

            font-size:42px;

            margin-bottom:12px;
        }

        .subtitle{

            text-align:center;

            color:#f3f4f6;

            margin-bottom:35px;

            line-height:1.7;
        }

        /* FORM GROUP */

        .form-group{

            margin-bottom:22px;
        }

        .form-group label{

            display:block;

            margin-bottom:10px;

            font-size:15px;

            font-weight:600;

            color:white;
        }

        /* INPUT BOX */

        .input-box{

            position:relative;
        }

        .input-box i{

            position:absolute;

            left:15px;

            top:18px;

            color:#9ca3af;

            font-size:15px;
        }

        input,
        textarea,
        select{

            width:100%;

            padding:15px 15px 15px 45px;

            border:none;

            outline:none;

            border-radius:12px;

            background:rgba(255,255,255,0.92);

            font-size:15px;

            color:#111827;
        }

        textarea{

            resize:none;
        }

        input:focus,
        textarea:focus,
        select:focus{

            background:white;
        }

        /* FILE INPUT */

        .file-input{

            padding:14px;

            background:rgba(255,255,255,0.92);

            border-radius:12px;

            color:#111827;
        }

        /* BUTTON */

        .submit-btn{

            width:100%;

            padding:16px;

            border:none;

            border-radius:14px;

            background:linear-gradient(
                90deg,
                #4f46e5,
                #a200ff
            );

            color:white;

            font-size:17px;

            font-weight:bold;

            cursor:pointer;

            transition:0.3s;

            margin-top:10px;
        }

        .submit-btn:hover{

            opacity:0.92;

            transform:translateY(-2px);
        }

        /* FOOTER */

        .footer-text{

            text-align:center;

            margin-top:25px;

            color:white;

            font-size:14px;
        }

        /* RESPONSIVE */

        @media(max-width:768px){

            .navbar{

                flex-direction:column;

                gap:20px;
            }

            .nav-links{

                flex-wrap:wrap;

                justify-content:center;
            }

            .form-card{

                padding:65px 25px 30px;
            }

            h1{

                font-size:34px;
            }

        }

    </style>

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">

            <div class="logo-icon">

                <i class="fa-solid fa-heart"></i>

            </div>

            <h2>CharityLens</h2>

        </div>

        <div class="nav-links">

            <a href="/beneficiary/dashboard">
                Dashboard
            </a>

            <a href="/submit-case">
                Submit Case
            </a>

            <a href="/cases/my">
                My Cases
            </a>

            <a href="/auth/logout">
                Logout
            </a>

        </div>

    </nav>

    <!-- MAIN -->

    <div class="main-container">

        <div class="form-card">

            <!-- ICON -->

            <div class="icon-box">

                <i class="fa-solid fa-file-circle-plus"></i>

            </div>

            <!-- TITLE -->

            <h1>

                Submit New Case

            </h1>

            <p class="subtitle">

                Create a verified fundraising case and
                receive support from donors securely.

            </p>

            <!-- FORM -->

            <form
                action="/cases/submit"
                method="POST"
                enctype="multipart/form-data"
            >

                <!-- TITLE -->

                <div class="form-group">

                    <label>Case Title</label>

                    <div class="input-box">

                        <i class="fa-solid fa-heading"></i>

                        <input
                            type="text"
                            name="title"
                            placeholder="Enter case title"
                            required
                        >

                    </div>

                </div>

                <!-- DESCRIPTION -->

                <div class="form-group">

                    <label>Case Description</label>

                    <div class="input-box">

                        <i class="fa-solid fa-align-left"></i>

                        <textarea
                            name="description"
                            placeholder="Enter case description"
                            rows="5"
                            required
                        ></textarea>

                    </div>

                </div>

                <!-- CATEGORY -->

                <div class="form-group">

                    <label>Select Category</label>

                    <div class="input-box">

                        <i class="fa-solid fa-layer-group"></i>

                        <select
                            name="category"
                            required
                        >

                            <option value="">
                                Select Category
                            </option>

                            <option value="Masjid">
                                Masjid
                            </option>

                            <option value="DarulUloom">
                                DarulUloom
                            </option>

                            <option value="Individual">
                                Individual
                            </option>

                        </select>

                    </div>

                </div>

                <!-- AMOUNT -->

                <div class="form-group">

                    <label>Required Amount</label>

                    <div class="input-box">

                        <i class="fa-solid fa-indian-rupee-sign"></i>

                        <input
                            type="number"
                            name="requiredAmount"
                            placeholder="Enter required amount"
                            required
                        >

                    </div>

                </div>

                <!-- PRIORITY -->

                <div class="form-group">

                    <label>Priority (Optional)</label>

                    <div class="input-box">

                        <i class="fa-solid fa-arrow-up-wide-short"></i>

                        <input
                            type="number"
                            name="priority"
                            placeholder="Enter priority"
                        >

                    </div>

                </div>

                <!-- IMAGE -->

                <div class="form-group">

                    <label>Proof Image</label>

                    <input
                        type="file"
                        name="proofImage"
                        class="file-input"
                    >

                </div>

                <!-- BUTTON -->

                <button
                    type="submit"
                    class="submit-btn"
                >

                    <i class="fa-solid fa-paper-plane"></i>

                    Submit Case

                </button>

            </form>

        </div>

        <!-- FOOTER -->

        <div class="footer-text">

            Protected by end-to-end encryption

        </div>

    </div>

</body>

</html>