<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>My Cases</title>
     <script>
         (function () {
           const saved = localStorage.getItem('theme');
           const theme = saved || 'light';
           document.documentElement.setAttribute('data-theme', theme);
         })();
       </script>

    <!-- Font Awesome -->
<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
   
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    
</head>

<body>
    
    <!-- NAVBAR -->
    <%- include('../partials/navbar') %>
    
    <!-- PAGE NAVIGATION -->
<%- include('../partials/page-navigation') %>

   

    <!-- TITLE -->
    <h1 class="page-title">

        My Submitted Cases

    </h1>

    <p class="subtitle">

        View all your submitted fundraising cases and
        track their approval and donation status.

    </p>

    <!-- CASES -->

    <div class="cases-container">

        <% cases.forEach(caseItem => { %>

           <div
    class="case-card open-case-modal"

    data-title="<%= caseItem.title %>"
    data-id="<%= caseItem._id %>"
    data-category="<%= caseItem.category %>"
    data-description="<%= caseItem.description %>"
    data-required="<%= caseItem.requiredAmount %>"
    data-collected="<%= caseItem.collectedAmount %>"
    data-status="<%= caseItem.isRejected ? 'Rejected' : caseItem.isVerified ? 'Verified' : 'Pending Verification' %>"
    data-reason="<%= caseItem.rejectionReason || '' %>"
    data-document="<%= caseItem.proofImage || '' %>"
>

                <!-- TITLE -->

                <h2>

                    <%= caseItem.title %>

                </h2>

                <!-- DETAILS -->

                <div class="case-card-top">

    <div class="case-avatar">

        <i class="fa-solid fa-user"></i>

    </div>

    <span class="case-category">

        <%= caseItem.category %>

    </span>

</div>

<p class="case-description">

    <%= caseItem.description %>

</p>

<div class="case-progress">

    <div class="progress-info">

        <span>

            ₹<%= (caseItem.collectedAmount || 0)
            .toLocaleString('en-IN') %>

        </span>

        <span>

            ₹<%= (caseItem.requiredAmount || 0)
            .toLocaleString('en-IN') %>

        </span>

    </div>

    <%
    const progress = Math.min(
        ((caseItem.collectedAmount || 0) /
        (caseItem.requiredAmount || 1)) * 100,
        100
    );
    %>

    <div class="progress-bar">

        <div
            class="progress-fill"
            style="width:<%= progress %>%"
        ></div>

    </div>

</div>

<p class="funding-percent">

    <%= Math.floor(progress) %>% Funded

</p>

<div class="priority-wrapper">

    <span class="priority-label">

        <%= caseItem.priority || 'Low' %>

    </span>

    <% if (caseItem.emergencyBypass) { %>
    <span style="background:#dc2626;color:#fff;padding:2px 8px;border-radius:20px;font-size:0.72rem;font-weight:700;margin-left:4px;">
        <i class="fa-solid fa-bolt"></i> EMERGENCY
    </span>
    <% } %>

    <div class="priority-battery">

        <div
            class="battery-level
            priority-<%= (caseItem.priority || 'low')
            .toLowerCase() %>"
        ></div>

    </div>

    <% if (caseItem.isVerified && caseItem.priorityScore) { %>
    <span style="font-size:0.72rem;color:#888;margin-left:6px;">
        Score: <%= caseItem.priorityScore.toFixed(2) %>
    </span>
    <% } %>

</div>

                <!-- STATUS -->

                <% if (caseItem.isRejected) { %>

                    <p class="status-badge rejected">

                        Rejected

                    </p>

                <% } else if (caseItem.isVerified) { %>

                    <p class="status-badge verified">

                        Verified

                    </p>

                <% } else { %>

                    <p class="status-badge pending">

                        Pending Verification

                    </p>

                <% } %>

            </div>

        <% }) %>

    </div>
    <script src="/js/dark-mode.js" defer></script>
 <!-- CASE MODAL -->
    <%- include('../partials/case-modal') %>
   
<%- include('../partials/footer') %>
</body>

</html>