<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>My Cases</title>

    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, sans-serif;
        }

        body{

            min-height:100vh;

            background: linear-gradient(
                180deg,
                #5a5df0 0%,
                #8f2fff 55%,
                #ff3ba7 100%
            );

            padding-bottom:40px;
        }

        /* NAVBAR */

        .navbar{

            width:100%;

            padding:20px 8%;

            display:flex;

            justify-content:space-between;

            align-items:center;

            background:rgba(255,255,255,0.08);

            backdrop-filter: blur(10px);

            margin-bottom:50px;
        }

        .logo{

            display:flex;
            align-items:center;
            gap:10px;
        }

        .logo-icon{

            width:45px;
            height:45px;

            border-radius:50%;

            background:rgba(255,255,255,0.15);

            display:flex;
            justify-content:center;
            align-items:center;

            color:white;
            font-size:18px;
        }

        .logo h2{

            color:white;
            font-size:28px;
        }

        .nav-links{

            display:flex;
            align-items:center;
            gap:25px;
        }

        .nav-links a{

            color:white;

            text-decoration:none;

            font-weight:600;

            transition:0.3s;
        }

        .nav-links a:hover{

            opacity:0.8;
        }

        /* PAGE TITLE */

        .page-title{

            text-align:center;

            color:white;

            font-size:48px;

            margin-bottom:15px;
        }

        .subtitle{

            text-align:center;

            color:#f3f4f6;

            font-size:18px;

            margin-bottom:45px;
        }

        /* GRID */

        .cases-container{

            width:90%;

            max-width:1300px;

            margin:auto;

            display:grid;

            grid-template-columns:
                repeat(auto-fit, minmax(340px, 1fr));

            gap:30px;
        }

        /* CARD */

        .case-card{

            background:rgba(255,255,255,0.12);

            backdrop-filter: blur(14px);

            border-radius:24px;

            padding:28px;

            color:white;

            box-shadow:0 10px 35px rgba(0,0,0,0.2);

            transition:0.3s;
        }

        .case-card:hover{

            transform:translateY(-5px);
        }

        /* TITLE */

        .case-card h2{

            font-size:28px;

            margin-bottom:20px;

            line-height:1.4;
        }

        /* DETAILS */

        .case-details{

            line-height:2;

            color:#f3f4f6;

            font-size:15px;
        }

        .case-details strong{

            color:white;
        }

        /* STATUS */

        .status{

            display:inline-block;

            margin-top:22px;

            padding:10px 18px;

            border-radius:30px;

            color:white;

            font-size:13px;

            font-weight:bold;

            text-transform:uppercase;
        }

        .verified{

            background:#22c55e;
        }

        .pending{

            background:#f59e0b;
        }

        .rejected{

            background:crimson;
        }

        /* REJECTION REASON */

        .reason-box{

            margin-top:18px;

            padding:15px;

            border-radius:14px;

            background:rgba(220,38,38,0.18);

            border:1px solid rgba(255,255,255,0.1);

            color:#ffe4e6;

            line-height:1.7;
        }

        .reason-box strong{

            color:white;
        }

        /* FOOTER */

        .footer-text{

            text-align:center;

            margin-top:50px;

            color:white;

            font-size:14px;
        }

        /* RESPONSIVE */

        @media(max-width:768px){

            .navbar{

                flex-direction:column;

                gap:20px;
            }

            .nav-links{

                flex-wrap:wrap;

                justify-content:center;
            }

            .page-title{

                font-size:36px;
            }

            .subtitle{

                font-size:16px;

                padding:0 15px;
            }

        }

    </style>

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">

            <div class="logo-icon">

                <i class="fa-solid fa-heart"></i>

            </div>

            <h2>CharityLens</h2>

        </div>

        <div class="nav-links">

            <a href="/beneficiary/dashboard">
                Dashboard
            </a>

            <a href="/submit-case">
                Submit Case
            </a>

            <a href="/cases/my">
                My Cases
            </a>

            <a href="/auth/logout">
                Logout
            </a>

        </div>

    </nav>

    <!-- TITLE -->

    <h1 class="page-title">

        My Submitted Cases

    </h1>

    <p class="subtitle">

        View all your submitted fundraising cases and
        track their approval and donation status.

    </p>

    <!-- CASES -->

    <div class="cases-container">

        <% cases.forEach(caseItem => { %>

            <div class="case-card">

                <!-- TITLE -->

                <h2>

                    <%= caseItem.title %>

                </h2>

                <!-- DETAILS -->

                <div class="case-details">

                    <p>

                        <strong>Category:</strong>

                        <%= caseItem.category %>

                    </p>

                    <p>

                        <strong>Description:</strong>

                        <%= caseItem.description %>

                    </p>

                    <p>

                        <strong>Required:</strong>

                        ₹<%= caseItem.requiredAmount %>

                    </p>

                    <p>

                        <strong>Collected:</strong>

                        ₹<%= caseItem.collectedAmount %>

                    </p>

                </div>

                <!-- STATUS -->

                <% if (caseItem.isRejected) { %>

                    <p class="status rejected">

                        Rejected

                    </p>

                    <!-- REASON -->

                    <div class="reason-box">

                        <strong>Reason:</strong>

                        <%= caseItem.rejectionReason %>

                    </div>

                <% } else if (caseItem.isVerified) { %>

                    <p class="status verified">

                        Verified

                    </p>

                <% } else { %>

                    <p class="status pending">

                        Pending Verification

                    </p>

                <% } %>

            </div>

        <% }) %>

    </div>

    <!-- FOOTER -->

    <div class="footer-text">

        Protected by end-to-end encryption

    </div>

</body>

</html>