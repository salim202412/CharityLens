<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>My Cases</title>

    <!-- Font Awesome -->
<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
   
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    
</head>

<body>
    
    <!-- NAVBAR -->
    <%- include('../partials/navbar') %>
    
    <!-- PAGE NAVIGATION -->
<%- include('../partials/page-navigation') %>

   

    <!-- TITLE -->
    <h1 class="page-title">

        My Submitted Cases

    </h1>

    <p class="subtitle">

        View all your submitted fundraising cases and
        track their approval and donation status.

    </p>

    <!-- CASES -->

    <div class="cases-container">

        <% cases.forEach(caseItem => { %>

           <div
    class="case-card open-case-modal"

    data-title="<%= caseItem.title %>"
    data-category="<%= caseItem.category %>"
    data-description="<%= caseItem.description %>"
    data-required="<%= caseItem.requiredAmount %>"
    data-collected="<%= caseItem.collectedAmount %>"
    data-status="<%= caseItem.isRejected ? 'Rejected' : caseItem.isVerified ? 'Verified' : 'Pending Verification' %>"
    data-reason="<%= caseItem.rejectionReason || '' %>"
    data-document="<%= caseItem.proofImage || '' %>"
>

                <!-- TITLE -->

                <h2>

                    <%= caseItem.title %>

                </h2>

                <!-- DETAILS -->

                <div class="case-details">

                    <p>

                        <strong>Category:</strong>

                        <%= caseItem.category %>

                    </p>

                    <p class="case-description">

                        <strong>Description:</strong>

                       <span><%= caseItem.description %></span>

                    </p>

                    <p>

                        <strong>Required:</strong>

                        ₹<%= caseItem.requiredAmount %>

                    </p>

                    <p>

                        <strong>Collected:</strong>

                        ₹<%= caseItem.collectedAmount %>

                    </p>

                </div>

                <!-- STATUS -->

                <% if (caseItem.isRejected) { %>

                    <p class="status rejected">

                        Rejected

                    </p>

                <% } else if (caseItem.isVerified) { %>

                    <p class="status verified">

                        Verified

                    </p>

                <% } else { %>

                    <p class="status pending">

                        Pending Verification

                    </p>

                <% } %>

            </div>

        <% }) %>

    </div>
 <!-- CASE MODAL -->
    <%- include('../partials/case-modal') %>
   
<%- include('../partials/footer') %>
</body>

</html>