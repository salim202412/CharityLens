<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>My Cases</title>

    <!-- Font Awesome -->
<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
   <link rel="stylesheet" href="/css/global.css">

    <link rel="stylesheet" href="/css/dashboard.css">
    
    
    
</head>

<body>
    
    <%- include('../partials/navbar') %>
    <%- include('../partials/page-navigation') %>



    <!-- TITLE -->

    <h1 class="page-title">

        My Submitted Cases

    </h1>

    <p class="subtitle">

        View all your submitted fundraising cases and
        track their approval and donation status.

    </p>

    <!-- CASES -->

    <div class="cases-container">

        <% cases.forEach(caseItem => { %>

            <div class="case-card">

                <!-- TITLE -->

                <h2>

                    <%= caseItem.title %>

                </h2>

                <!-- DETAILS -->

                <div class="case-details">

                    <p>

                        <strong>Category:</strong>

                        <%= caseItem.category %>

                    </p>

                    <p>

                        <strong>Description:</strong>

                        <%= caseItem.description %>

                    </p>

                    <p>

                        <strong>Required:</strong>

                        ₹<%= caseItem.requiredAmount %>

                    </p>

                    <p>

                        <strong>Collected:</strong>

                        ₹<%= caseItem.collectedAmount %>

                    </p>

                </div>

                <!-- STATUS -->

                <% if (caseItem.isRejected) { %>

                    <p class="status rejected">

                        Rejected

                    </p>

                    <!-- REASON -->

                    <div class="reason-box">

                        <strong>Reason:</strong>

                        <%= caseItem.rejectionReason %>

                    </div>

                <% } else if (caseItem.isVerified) { %>

                    <p class="status verified">

                        Verified

                    </p>

                <% } else { %>

                    <p class="status pending">

                        Pending Verification

                    </p>

                <% } %>

            </div>

        <% }) %>

    </div>

   
<%- include('../partials/footer') %>
</body>

</html>